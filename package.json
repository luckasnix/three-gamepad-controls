{
  "name": "three-gamepad-controls",
  "description": "Gamepad support for Three.js controls.",
  "version": "0.25.5",
  "license": "MIT",
  "homepage": "https://github.com/luckasnix/three-gamepad-controls#readme",
  "author": {
    "name": "Kasnix",
    "url": "https://github.com/luckasnix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckasnix/three-gamepad-controls.git"
  },
  "bugs": {
    "url": "https://github.com/luckasnix/three-gamepad-controls/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "three",
    "controls",
    "gamepad"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc && tsdown",
    "type:check": "tsc --noEmit",
    "format:check": "biome format",
    "format:write": "biome format --write",
    "lint:check": "biome lint",
    "lint:write": "biome lint --write",
    "check-all": "biome check",
    "write-all": "biome check --write",
    "check-ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "playwright": "1.64.1",
    "three": "0.186.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@types/three": "~0.186.0",
    "three": "~0.186.0"
  }
}
